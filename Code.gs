/**
 * Changes a user's email everywhere (Users, Tasks, Initiatives, Projects, Comments,
 * Notifications, ActivityLog). Run from the editor, e.g.
 *   renameUserEmail('nitish@justlife.com', 'nitish.kumar@justlife.com')
 * or from the app: Settings ▸ Users ▸ Edit.
 */
function renameUserEmail(oldEmail, newEmail) {
  REQ = {};
  const from = lc_(oldEmail), to = lc_(newEmail);
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) throw err_('VALIDATION', 'Enter a valid new email address.');
  if (from === to) return 0;
  return withLock_(function () {
    const users = readTable_('Users');
    if (!users.rows.some(function (r) { return lc_(r.Email) === from; })) throw err_('NOT_FOUND', 'No user with email ' + from + '.');
    if (users.rows.some(function (r) { return lc_(r.Email) === to; })) throw err_('VALIDATION', to + ' already exists. Deactivate one of the two users instead.');
    const single = { Users: ['Email'], Tasks: ['AssignedTo', 'CreatedBy', 'UpdatedBy'], Initiatives: ['Owner', 'CreatedBy', 'UpdatedBy'],
      Projects: ['Owner', 'CreatedBy', 'UpdatedBy'], Comments: ['AuthorEmail'], Notifications: ['Recipient', 'Actor'], ActivityLog: ['ActorEmail'] };
    const multi = { Tasks: ['Collaborators'], Initiatives: ['Members'] };
    let n = 0;
    Object.keys(single).forEach(function (name) {
      const tbl = readTable_(name);
      tbl.rows.forEach(function (r) {
        let dirty = false;
        single[name].forEach(function (c) { if (lc_(r[c]) === from) { r[c] = to; dirty = true; } });
        if (name === 'ActivityLog' && r.EntityType === 'User' && lc_(r.EntityID) === from) { r.EntityID = to; dirty = true; }
        if (name === 'Notifications' && String(r.DedupeKey).slice(-from.length - 1) === ':' + from) { r.DedupeKey = String(r.DedupeKey).slice(0, -from.length) + to; dirty = true; }
        (multi[name] || []).forEach(function (c) {
          const l = list_(r[c]).map(lc_);
          if (l.indexOf(from) >= 0) { r[c] = l.map(function (e) { return e === from ? to : e; }).join(', '); dirty = true; }
        });
        if (dirty) { writeRow_(tbl, r); n++; }
      });
    });
    logActivity_({ email: 'system', name: 'System' }, 'User', to, 'User email changed', from + ' → ' + to + ' (' + n + ' rows updated)');
    bumpRev_();
    console.log('renameUserEmail: ' + from + ' → ' + to + ', ' + n + ' rows updated');
    return n;
  });
}

