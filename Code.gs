/* =====================================================================
 *  DATA ACCESS LAYER
 * ===================================================================== */

function ss_() {
  if (!_ss) _ss = CONFIG.SPREADSHEET_ID ? SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID) : SpreadsheetApp.getActiveSpreadsheet();
  return _ss;
}

function sheet_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw err_('SETUP_REQUIRED', 'The "' + name + '" tab is missing. Run setupHealthcareBoard() in Apps Script.');
  return sh;
}

function colType_(sheetName, header) {
  const def = SCHEMA[sheetName];
  if (!def) return 'text';
  if (!def._types) { def._types = {}; def.cols.forEach(function (c) { def._types[c[0]] = c[1]; }); }
  return def._types[header] || 'text';
}

function readTable_(name) {
  const sh = sheet_(name);
  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  if (!lastCol) throw err_('SETUP_REQUIRED', 'The "' + name + '" tab has no headers. Run setupHealthcareBoard().');
  const values = sh.getRange(1, 1, Math.max(lastRow, 1), lastCol).getValues();
  const headers = values[0].map(function (h) { return String(h).trim(); });
  const rows = [];
  for (let i = 1; i < values.length; i++) {
    const v = values[i];
    if (v.every(function (x) { return x === '' || x === null; })) continue;
    const o = { _row: i + 1 };
    headers.forEach(function (h, j) { if (h) o[h] = fromCell_(v[j], colType_(name, h)); });
    rows.push(o);
  }
  return { name: name, sh: sh, headers: headers, rows: rows };
}

function readTail_(name, n) {
  const sh = sheet_(name);
  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); });
  if (lastRow < 2) return [];
  const start = Math.max(2, lastRow - n + 1);
  const values = sh.getRange(start, 1, lastRow - start + 1, lastCol).getValues();
  return values.map(function (v, i) {
    const o = { _row: start + i };
    headers.forEach(function (h, j) { if (h) o[h] = fromCell_(v[j], colType_(name, h)); });
    return o;
  }).filter(function (o) { return Object.keys(o).some(function (k) { return k !== '_row' && o[k] !== ''; }); });
}

function fromCell_(v, type) {
  if (v instanceof Date) {
    if (type === 'date') return Utilities.formatDate(v, tz_(), 'yyyy-MM-dd');
    return v.toISOString();
  }
  if (type === 'bool') return v === true || String(v).toUpperCase() === 'TRUE';
  if (type === 'num') { if (v === '' || v === null) return ''; const n = Number(v); return isNaN(n) ? '' : n; }
  if (v === null || v === undefined) return '';
  const s = String(v);
  return /^'[=+]/.test(s) ? s.slice(1) : s; // undo the formula guard added by toCell_
}

function toCell_(v, type) {
  if (type === 'bool') return v === true || String(v).toUpperCase() === 'TRUE';
  if (type === 'num') { if (v === '' || v === null || v === undefined) return ''; const n = Number(v); return isNaN(n) ? '' : n; }
  let s = v === null || v === undefined ? '' : String(v);
  if (/^[=+]/.test(s)) s = "'" + s; // never let user input become a formula
  return s;
}

function rowArray_(tbl, obj) {
  return tbl.headers.map(function (h) { return h ? toCell_(obj[h], colType_(tbl.name, h)) : ''; });
}

function writeRow_(tbl, obj) {
  if (!obj._row) throw new Error('writeRow_ requires a row number');
  tbl.sh.getRange(obj._row, 1, 1, tbl.headers.length).setValues([rowArray_(tbl, obj)]);
}

function appendRows_(tbl, objs) {
  if (!objs.length) return;
  const start = tbl.sh.getLastRow() + 1;
  tbl.sh.getRange(start, 1, objs.length, tbl.headers.length).setValues(objs.map(function (o) { return rowArray_(tbl, o); }));
  objs.forEach(function (o, i) { o._row = start + i; tbl.rows.push(o); });
}

function blank_(name) {
  const o = {};
  SCHEMA[name].cols.forEach(function (c) { o[c[0]] = c[1] === 'bool' ? false : ''; });
  return o;
}

function pub_(o) {
  const r = {};
  Object.keys(o).forEach(function (k) { if (k !== '_row') r[k] = o[k]; });
  return r;
}

function settings_() {
  if (REQ.settings) return REQ.settings;
  const s = {};
  DEFAULT_SETTINGS.forEach(function (d) { s[d[0]] = d[1]; });
  readTable_('Settings').rows.forEach(function (r) { if (r.Key) s[r.Key] = String(r.Value).trim(); });
  REQ.settings = s;
  return s;
}

function users_() {
  if (!REQ.users) REQ.users = readTable_('Users').rows.map(function (u) { u.Email = lc_(u.Email); return u; });
  return REQ.users;
}

function userMap_() {
  const m = {};
  users_().forEach(function (u) { m[u.Email] = u; });
  return m;
}

function publicUser_(u) {
  return { Email: lc_(u.Email), Name: u.Name || lc_(u.Email).split('@')[0], Role: u.Role, Department: u.Department || '', Title: u.Title || '', Active: !!u.Active, LastLogin: u.LastLogin || '' };
}

function nameOf_(email) {
  if (!email) return 'TBD';
  const u = userMap_()[lc_(email)];
  return u ? (u.Name || u.Email) : (email || '—');
}

function refs_(taskRows) {
  const r = { users: userMap_(), initiatives: {}, projects: {}, taskIds: [], taskIdSet: {} };
  readTable_('Initiatives').rows.forEach(function (i) { r.initiatives[i.InitiativeID] = i; });
  readTable_('Projects').rows.forEach(function (p) { r.projects[p.ProjectID] = p; });
  taskRows.forEach(function (t) { r.taskIds.push(t.TaskID); r.taskIdSet[t.TaskID] = true; });
  return r;
}

function stageCaps_() {
  const caps = {};
  list_(settings_().STAGE_CAPS).forEach(function (p) {
    const m = p.split('=');
    if (m.length === 2 && Number(m[1]) > 0) caps[m[0].trim()] = Number(m[1]);
  });
  return caps;
}

/** Header-only table handle — for append-only writes that do not need existing rows. */
function tableHead_(name) {
  const sh = sheet_(name);
  const lastCol = sh.getLastColumn();
  if (!lastCol) throw err_('SETUP_REQUIRED', 'The "' + name + '" tab has no headers. Run setupHealthcareBoard().');
  return { name: name, sh: sh, headers: sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); }), rows: [] };
}

function logActivity_(ctx, entityType, entityId, action, details) {
  const tbl = tableHead_('ActivityLog');
  const rec = {
    LogID: 'LOG-' + Date.now().toString(36).toUpperCase() + '-' + Utilities.getUuid().slice(0, 4).toUpperCase(),
    Timestamp: nowIso_(), ActorEmail: ctx.email || '', ActorName: ctx.name || '', EntityType: entityType,
    EntityID: entityId, Action: action, Details: String(details || '').slice(0, 1000)
  };
  appendRows_(tbl, [rec]);
}

/* =====================================================================
 *  CONCURRENCY, IDS & REVISION
 * ===================================================================== */

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(CONFIG.LOCK_TIMEOUT_MS)) throw err_('BUSY', 'The board is busy saving other changes. Please try again in a moment.');
  try { return fn(); } finally { lock.releaseLock(); }
}

function nextId_(prefix, existingIds) {
  const props = PropertiesService.getScriptProperties();
  const key = 'SEQ_' + prefix;
  let n = Number(props.getProperty(key) || 0);
  const taken = {};
  (existingIds || []).forEach(function (id) { taken[id] = true; });
  let id;
  do { n++; id = prefix + '-' + ('00000' + n).slice(-Math.max(5, String(n).length)); } while (taken[id]);
  props.setProperty(key, String(n));
  return id;
}

function checkVersion_(rec, clientVersion, label) {
  if (clientVersion === undefined || clientVersion === null || clientVersion === '') return;
  if (Number(clientVersion) !== Number(rec.Version)) {
    throw err_('CONFLICT', 'This ' + label + ' was changed by ' + nameOf_(rec.UpdatedBy) + ' since you opened it. Your changes were not saved — review the latest version and try again.', { latest: pub_(rec) });
  }
}

function getRev_() { return PropertiesService.getScriptProperties().getProperty('REV') || '0'; }
function bumpRev_() {
  const r = String(Date.now().toString(36)) + '.' + Utilities.getUuid().slice(0, 4);
  PropertiesService.getScriptProperties().setProperty('REV', r);
  return r;
}

/* =====================================================================
 *  UTILITIES
 * ===================================================================== */

function ok_(data) { return { ok: true, data: data }; }
function err_(code, message, details) { const e = new Error(message); e.appCode = code; e.details = details; return e; }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function nowIso_() { return new Date().toISOString(); }
function lc_(s) { return String(s || '').trim().toLowerCase(); }
function truthy_(v) { return v === true || /^(true|yes|1)$/i.test(String(v || '').trim()); }
function list_(s) { return String(s || '').split(',').map(function (x) { return x.trim(); }).filter(String); }
function isYmd_(s) { return /^\d{4}-\d{2}-\d{2}$/.test(s) && !isNaN(new Date(s + 'T00:00:00Z').getTime()); }
function excerpt_(s, n) { s = String(s || '').replace(/\s+/g, ' '); return s.length > n ? s.slice(0, n - 1) + '…' : s; }
function tz_() { try { return settings_().TIMEZONE || Session.getScriptTimeZone(); } catch (e) { return Session.getScriptTimeZone(); } }
function today_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }
function addDays_(ymd, n) { const d = new Date(ymd + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }

/** Trim, strip control characters and enforce a maximum length. */
function str_(v, max, field, multiline) {
  let s = v === null || v === undefined ? '' : String(v);
  s = multiline ? s.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g, '').replace(/\r\n/g, '\n')
    : s.replace(/[\u0000-\u001F\u007F]/g, ' ');
  s = s.trim();
  if (max && s.length > max) throw err_('VALIDATION', (field || 'Value') + ' must be at most ' + max + ' characters.', { fields: (function () { const f = {}; f[field] = 'Maximum ' + max + ' characters.'; return f; })() });
  return s;
}

function diff_(a, b, fields) {
  const out = [];
  fields.forEach(function (f) {
    const x = a[f] === undefined || a[f] === null ? '' : String(a[f]);
    const y = b[f] === undefined || b[f] === null ? '' : String(b[f]);
    if (x !== y) out.push({ field: f, from: x, to: y });
  });
  return out;
}
