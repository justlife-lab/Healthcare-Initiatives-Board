  const ids = JSON.parse(props.getProperty('SAMPLE_IDS') || '[]');
  if (!ids.length) return 'No sample data recorded.';
  withLock_(function () {
    ['Tasks', 'Initiatives', 'Projects', 'Comments'].forEach(function (name) {
      const key = name === 'Comments' ? 'TaskID' : SCHEMA[name].key;
      const tbl = readTable_(name);
      tbl.rows.filter(function (r) { return ids.indexOf(r[key]) >= 0 && (name !== 'Comments' || /^\[SAMPLE\]/.test(r.Body) || r.Status === 'deleted'); })
        .sort(function (a, b) { return b._row - a._row; })
        .forEach(function (r) { tbl.sh.deleteRow(r._row); });
    });
    props.deleteProperty('SAMPLE_IDS');
    bumpRev_();
  });
  return 'Removed ' + ids.length + ' sample records.';
