function saveUser_(ctx, p) {
  requireRole_(ctx, ['Admin', 'Manager'], 'Only administrators and managers can manage users.');
  const email = lc_(str_(p.email, 200, 'email'));
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw err_('VALIDATION', 'Enter a valid email address.', { fields: { Email: 'Enter a valid email address.' } });
  const patch = p.patch || {};
  return withLock_(function () {
    const tbl = readTable_('Users');
    let u = tbl.rows.find(function (r) { return lc_(r.Email) === email; });
    const isNew = !u;
    if (isNew) u = { Email: email, Name: '', Role: 'Member', Department: '', Title: '', Active: true, CreatedAt: nowIso_(), LastLogin: '' };
    const before = JSON.parse(JSON.stringify(u));
    if (ctx.role === 'Manager') {
      if (!isNew && (before.Role === 'Admin' || before.Role === 'Manager') && lc_(before.Email) !== ctx.email) throw err_('FORBIDDEN', 'Managers cannot edit administrators or other managers.');
      if ('Role' in patch && ['Member', 'Viewer'].indexOf(patch.Role) < 0 && !(lc_(before.Email) === ctx.email && patch.Role === before.Role)) throw err_('FORBIDDEN', 'Managers can only give the Member or Viewer role.', { fields: { Role: 'Managers can assign Member or Viewer only.' } });
    }
    ['Name', 'Role', 'Department', 'Title', 'Active'].forEach(function (f) { if (f in patch) u[f] = patch[f]; });
    u.Name = str_(u.Name, 120, 'Name') || email.split('@')[0];
    u.Department = str_(u.Department, 100, 'Department');
    u.Title = str_(u.Title, 100, 'Title');
    u.Active = truthy_(u.Active);
    if (ROLES.indexOf(u.Role) < 0) throw err_('VALIDATION', 'Choose a valid role.', { fields: { Role: 'Choose a valid role.' } });
    const admins = tbl.rows.filter(function (r) { return r.Role === 'Admin' && r.Active && lc_(r.Email) !== email; }).length;
    if (!isNew && before.Role === 'Admin' && (u.Role !== 'Admin' || !u.Active) && admins === 0) {
      throw err_('VALIDATION', 'At least one active administrator is required.');
    }
    if (isNew) appendRows_(tbl, [u]); else writeRow_(tbl, u);
    const changes = isNew ? [] : diff_(before, u, ['Name', 'Role', 'Department', 'Title', 'Active']);
    logActivity_(ctx, 'User', email, isNew ? 'User added' : 'User updated',
      isNew ? u.Name + ' added as ' + u.Role + '.' : changes.map(function (c) { return c.field + ': ' + c.from + ' → ' + c.to; }).join('; '));
    bumpRev_();
    return { user: publicUser_(u) };
  });
}

function saveSettings_(ctx, p) {
  requireRole_(ctx, ['Admin'], 'Only administrators can change settings.');
  const values = p.values || {};
  return withLock_(function () {
    const tbl = readTable_('Settings');
    const changed = [];
    Object.keys(values).forEach(function (k) {
      if (EDITABLE_SETTINGS.indexOf(k) < 0) return;
      const v = str_(values[k], 2000, k);
      const row = tbl.rows.find(function (r) { return r.Key === k; });
      if (row && row.Value !== v) { row.Value = v; writeRow_(tbl, row); changed.push(k); }
    });
    if (changed.length) {
      logActivity_(ctx, 'Settings', 'Settings', 'Settings updated', changed.join(', '));
      bumpRev_();
    }
    REQ.settings = null;
    return { changed: changed, settings: publicSettings_(settings_()) };
  });
}

function publicSettings_(s) {
  return {
    APP_NAME: s.APP_NAME, ORG_NAME: s.ORG_NAME, AUTH_MODE: s.AUTH_MODE, ALLOWED_DOMAINS: s.ALLOWED_DOMAINS,
    AUTO_PROVISION: s.AUTO_PROVISION, DEFAULT_ROLE: s.DEFAULT_ROLE, SESSION_HOURS: s.SESSION_HOURS, TIMEZONE: s.TIMEZONE,
    POLL_SECONDS: s.POLL_SECONDS, DUE_SOON_DAYS: s.DUE_SOON_DAYS, CATEGORIES: s.CATEGORIES, FORUMS: s.FORUMS,
    DEPARTMENTS: s.DEPARTMENTS, STAGE_CAPS: s.STAGE_CAPS
  };
}

