/* Per-request cache — reset at the start of every request. */
let REQ = {};
let _ss = null;

/* =====================================================================
 *  HTTP ENTRY POINTS
 * ===================================================================== */

function doGet(e) {
  return json_({ ok: true, data: { app: 'Healthcare Initiatives Board API', version: CONFIG.APP_VERSION, time: nowIso_() } });
}

function doPost(e) {
  let req;
  try {
    req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    return json_({ ok: false, error: { code: 'BAD_REQUEST', message: 'Request body is not valid JSON.' } });
  }
  return json_(handleRequest_(req));
}

const ROUTES = {
  bootstrap: function (ctx) { return bootstrap_(ctx); },
  sync: function (ctx, p) { return sync_(ctx, p); },
  getTask: function (ctx, p) { return getTask_(ctx, p); },
  saveTask: function (ctx, p) { return saveTask_(ctx, p); },
  duplicateTask: function (ctx, p) { return duplicateTask_(ctx, p); },
  archiveTask: function (ctx, p) { return archiveTask_(ctx, p); },
  addComment: function (ctx, p) { return addComment_(ctx, p); },
  editComment: function (ctx, p) { return editComment_(ctx, p); },
  deleteComment: function (ctx, p) { return deleteComment_(ctx, p); },
  saveInitiative: function (ctx, p) { return saveInitiative_(ctx, p); },
  archiveInitiative: function (ctx, p) { return archiveSimple_(ctx, p, 'Initiatives', 'Initiative'); },
  saveProject: function (ctx, p) { return saveProject_(ctx, p); },
  archiveProject: function (ctx, p) { return archiveSimple_(ctx, p, 'Projects', 'Project'); },
  getActivity: function (ctx, p) { return getActivity_(ctx, p); },
  markNotifications: function (ctx, p) { return markNotifications_(ctx, p); },
  saveUser: function (ctx, p) { return saveUser_(ctx, p); },
  saveSettings: function (ctx, p) { return saveSettings_(ctx, p); },
  importTasks: function (ctx, p) { return importTasks_(ctx, p); },
  renameUser: function (ctx, p) {
    requireRole_(ctx, ['Admin', 'Manager'], 'Only administrators and managers can change a user\'s email.');
    if (ctx.role === 'Manager') { const t = userMap_()[lc_(p.oldEmail)]; if (t && (t.Role === 'Admin' || t.Role === 'Manager')) throw err_('FORBIDDEN', 'Managers cannot change the email of administrators or other managers.'); }
    return { changed: renameUserEmail(p.oldEmail, p.newEmail) };
  },
  logout: function (ctx, p, token) { CacheService.getScriptCache().remove('sess:' + token); return { loggedOut: true }; }
};

function handleRequest_(req) {
  REQ = {};
  try {
    req = req || {};
    const action = String(req.action || '');
    if (action === 'ping') return ok_({ pong: true, version: CONFIG.APP_VERSION, time: nowIso_() });
    if (action === 'config') return ok_(publicConfig_());
    if (action === 'login') return ok_(login_(req.payload || {}));
    const fn = ROUTES[action];
    if (!fn) throw err_('BAD_REQUEST', 'Unknown action: ' + action);
    const ctx = auth_(req.token);
    return ok_(fn(ctx, req.payload || {}, req.token));
  } catch (e) {
    if (e && e.appCode) return { ok: false, error: { code: e.appCode, message: e.message, details: e.details || null } };
    console.error('Unhandled server error: ' + (e && e.stack ? e.stack : e));
    return { ok: false, error: { code: 'SERVER_ERROR', message: 'Unexpected server error: ' + (e && e.message ? e.message : String(e)) } };
  }
}

/* =====================================================================
 *  AUTHENTICATION & AUTHORISATION
 * ===================================================================== */

function publicConfig_() {
  let s;
  try { s = settings_(); } catch (e) { return { setupRequired: true, message: e.message }; }
  return {
    setupRequired: false,
    authMode: String(s.AUTH_MODE || 'google').toLowerCase(),
    clientIdConfigured: !!s.GOOGLE_CLIENT_ID,
    appName: s.APP_NAME, orgName: s.ORG_NAME, version: CONFIG.APP_VERSION
  };
}

function login_(p) {
  const s = settings_();
  const mode = String(s.AUTH_MODE || 'google').toLowerCase();
  let email = '', name = '', verified = false;

  if (p.idToken) {
    const info = verifyIdToken_(String(p.idToken), String(s.GOOGLE_CLIENT_ID || ''));
    email = info.email; name = info.name || ''; verified = true;
  } else if (p.testEmail) {
    if (mode !== 'test') throw err_('AUTH_REQUIRED', 'Email-only sign-in is disabled. Please sign in with Google.');
    email = String(p.testEmail).trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw err_('VALIDATION', 'Enter a valid email address.');
  } else {
    throw err_('AUTH_REQUIRED', 'Sign-in credentials are missing.');
  }

  return withLock_(function () {
    const users = readTable_('Users');
    let u = users.rows.find(function (r) { return lc_(r.Email) === email; });
    if (u) {
      if (!u.Active) throw err_('UNAUTHORIZED', 'Your account (' + email + ') has been deactivated. Contact an administrator.');
    } else {
      const domain = email.split('@')[1];
      const allowed = list_(s.ALLOWED_DOMAINS).map(lc_);
      if (verified && allowed.indexOf(domain) >= 0 && truthy_(s.AUTO_PROVISION)) {
        const role = ROLES.indexOf(s.DEFAULT_ROLE) >= 0 && s.DEFAULT_ROLE !== 'Admin' ? s.DEFAULT_ROLE : 'Member';
        u = { Email: email, Name: name || email.split('@')[0], Role: role, Department: '', Title: '', Active: true, CreatedAt: nowIso_(), LastLogin: '' };
        appendRows_(users, [u]);
        logActivity_({ email: email, name: u.Name }, 'User', email, 'User auto-provisioned', 'Signed in for the first time from an allowed domain; role ' + role + '.');
      } else {
        throw err_('UNAUTHORIZED', 'The account ' + email + ' is not authorised to use this board. Ask an administrator to add you.');
      }
    }
    if (name && !u.Name) u.Name = name;
    u.LastLogin = nowIso_();
    writeRow_(users, u);

    const hours = Math.max(1, Math.min(6, Number(s.SESSION_HOURS) || 6));
    const token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
    const expiresAt = new Date(Date.now() + hours * 3600 * 1000).toISOString();
    CacheService.getScriptCache().put('sess:' + token, JSON.stringify({ email: email, verified: verified, exp: expiresAt }), hours * 3600);
    return { token: token, expiresAt: expiresAt, verified: verified, user: publicUser_(u) };
  });
}

function verifyIdToken_(idToken, clientId) {
  if (!clientId) throw err_('CONFIG', 'GOOGLE_CLIENT_ID is not set in the Settings tab.');
  const resp = UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken), { muteHttpExceptions: true });
  if (resp.getResponseCode() !== 200) throw err_('AUTH_INVALID', 'Google could not verify your sign-in. Please sign in again.');
  const p = JSON.parse(resp.getContentText());
  if (p.aud !== clientId) throw err_('AUTH_INVALID', 'Sign-in token was issued for a different application.');
  if (p.iss !== 'accounts.google.com' && p.iss !== 'https://accounts.google.com') throw err_('AUTH_INVALID', 'Invalid token issuer.');
  if (String(p.email_verified) !== 'true') throw err_('AUTH_INVALID', 'Your Google email address is not verified.');
  if (Number(p.exp) * 1000 < Date.now()) throw err_('AUTH_EXPIRED', 'Your Google sign-in expired. Please sign in again.');
  return { email: lc_(p.email), name: p.name || '', picture: p.picture || '' };
}

function auth_(token) {
  if (!token) throw err_('AUTH_REQUIRED', 'Please sign in.');
  const raw = CacheService.getScriptCache().get('sess:' + token);
  if (!raw) throw err_('AUTH_EXPIRED', 'Your session has expired. Please sign in again.');
  const sess = JSON.parse(raw);
  const u = users_().find(function (r) { return lc_(r.Email) === sess.email; });
  if (!u || !u.Active) throw err_('UNAUTHORIZED', 'Your account is no longer authorised.');
  return { email: lc_(u.Email), name: u.Name || u.Email, role: u.Role || 'Member', verified: !!sess.verified };
}

function isManager_(ctx) { return ctx.role === 'Admin' || ctx.role === 'Manager'; }
function requireRole_(ctx, roles, msg) {
  if (roles.indexOf(ctx.role) < 0) throw err_('FORBIDDEN', msg || 'You do not have permission to perform this action.');
}
function canEditTask_(ctx, t) {
  if (isManager_(ctx)) return true;
  if (ctx.role === 'Viewer') return false;
  return lc_(t.CreatedBy) === ctx.email || lc_(t.AssignedTo) === ctx.email || list_(t.Collaborators).map(lc_).indexOf(ctx.email) >= 0;
}

/* =====================================================================
 *  READ API
 * ===================================================================== */

function bootstrap_(ctx) {
  const s = settings_();
  const tasks = readTable_('Tasks').rows.map(pub_);
  const comments = readTable_('Comments').rows;
  const stats = {};
  comments.forEach(function (c) {
    if (c.Status === 'deleted') return;
    const st = stats[c.TaskID] || (stats[c.TaskID] = { count: 0, lastAt: '', lastBy: '' });
    st.count++;
    if (c.CreatedAt > st.lastAt) { st.lastAt = c.CreatedAt; st.lastBy = lc_(c.AuthorEmail); }
  });
  const recentComments = comments.filter(function (c) { return c.Status !== 'deleted'; })
    .sort(function (a, b) { return a.CreatedAt < b.CreatedAt ? 1 : -1; }).slice(0, 60).map(pub_);
  const notifications = readTable_('Notifications').rows
    .filter(function (n) { return lc_(n.Recipient) === ctx.email; })
    .sort(function (a, b) { return a.CreatedAt < b.CreatedAt ? 1 : -1; })
    .slice(0, CONFIG.NOTIFICATION_LIMIT).map(pub_);
  return {
    changed: true,
    rev: getRev_(),
    serverTime: nowIso_(),
    today: today_(),
    me: { email: ctx.email, name: ctx.name, role: ctx.role, verified: ctx.verified },
    settings: publicSettings_(s),
    users: users_().map(publicUser_),
    tasks: tasks,
    initiatives: readTable_('Initiatives').rows.map(pub_),
    projects: readTable_('Projects').rows.map(pub_),
    commentStats: stats,
    recentComments: recentComments,
    notifications: notifications,
    activity: readTail_('ActivityLog', CONFIG.ACTIVITY_TAIL).reverse().map(pub_)
  };
}

function sync_(ctx, p) {
  const rev = getRev_();
  if (p && p.rev && String(p.rev) === String(rev)) return { changed: false, rev: rev, serverTime: nowIso_() };
  return bootstrap_(ctx);
}

function getTask_(ctx, p) {
  const id = str_(p.id, 40, 'id');
  const tasks = readTable_('Tasks').rows;
  const t = tasks.find(function (r) { return r.TaskID === id; });
  if (!t) throw err_('NOT_FOUND', 'Task ' + id + ' was not found.');
  return {
    task: pub_(t),
    comments: commentsFor_(id),
    activity: readTable_('ActivityLog').rows.filter(function (a) { return a.EntityID === id; })
      .sort(function (a, b) { return a.Timestamp < b.Timestamp ? 1 : -1; }).slice(0, 100).map(pub_),
    dependencies: list_(t.DependsOn).map(function (d) {
      const x = tasks.find(function (r) { return r.TaskID === d; });
      return x ? { TaskID: x.TaskID, Title: x.Title, Status: x.Status } : { TaskID: d, Title: '(missing)', Status: '' };
    }),
    dependents: tasks.filter(function (r) { return list_(r.DependsOn).indexOf(id) >= 0; })
      .map(function (x) { return { TaskID: x.TaskID, Title: x.Title, Status: x.Status }; })
  };
}

function commentsFor_(taskId) {
  return readTable_('Comments').rows.filter(function (c) { return c.TaskID === taskId; })
    .sort(function (a, b) { return a.CreatedAt < b.CreatedAt ? -1 : 1; })
    .map(function (c) {
      const o = pub_(c);
      if (o.Status === 'deleted') o.Body = '';
      return o;
    });
}

function getActivity_(ctx, p) {
  const limit = Math.min(1000, Math.max(1, Number(p.limit) || 300));
  let rows = p.entityId ? readTable_('ActivityLog').rows.filter(function (a) { return a.EntityID === p.entityId; })
    : readTail_('ActivityLog', limit);
  rows = rows.sort(function (a, b) { return a.Timestamp < b.Timestamp ? 1 : -1; }).slice(0, limit);
  return { activity: rows.map(pub_) };
}

/* =====================================================================
 *  TASKS
 * ===================================================================== */

const TASK_FIELDS = ['Title', 'Description', 'InitiativeID', 'ProjectID', 'Category', 'Team', 'AssignedTo', 'Collaborators',
  'Priority', 'Status', 'StartDate', 'DueDate', 'Progress', 'DependsOn', 'Links'];

function saveTask_(ctx, p) {
  const patch = p.patch || {};
  const id = p.id ? str_(p.id, 40, 'id') : '';
  return withLock_(function () {
    const tbl = readTable_('Tasks');
    const refs = refs_(tbl.rows);
    const now = nowIso_();

    if (!id) {
      requireRole_(ctx, ['Admin', 'Manager', 'Member'], 'Viewers cannot create tasks.');
      const t = blank_('Tasks');
      TASK_FIELDS.forEach(function (f) { if (f in patch) t[f] = patch[f]; });
      if (!t.Status) t.Status = 'Not Started';
      if (!t.Priority) t.Priority = 'Medium';
      if (t.Progress === '' || t.Progress == null) t.Progress = 0;
      t.TaskID = nextId_('TSK', refs.taskIds);
      validateTask_(t, refs, {});
      t.CreatedBy = ctx.email; t.CreatedAt = now; t.UpdatedAt = now; t.UpdatedBy = ctx.email;
      t.Archived = false; t.Version = 1;
      appendRows_(tbl, [t]);
      logActivity_(ctx, 'Task', t.TaskID, 'Task created', '"' + t.Title + '" assigned to ' + nameOf_(t.AssignedTo) + ', due ' + t.DueDate + '.');
      notifyTaskChanges_(ctx, null, t);
      bumpRev_();
      return { task: pub_(t), created: true };
    }

    const t = tbl.rows.find(function (r) { return r.TaskID === id; });
    if (!t) throw err_('NOT_FOUND', 'Task ' + id + ' was not found. It may have been removed.');
    if (!canEditTask_(ctx, t)) throw err_('FORBIDDEN', 'Only the creator, assignee, collaborators or a manager can edit this task.');
    checkVersion_(t, p.version, 'task');
    const before = JSON.parse(JSON.stringify(t));
    TASK_FIELDS.forEach(function (f) { if (f in patch) t[f] = patch[f]; });
    validateTask_(t, refs, before);
    const changes = diff_(before, t, TASK_FIELDS.concat(['CompletedDate']));
    if (!changes.length) return { task: pub_(before), unchanged: true };
    t.UpdatedAt = now; t.UpdatedBy = ctx.email; t.Version = (Number(before.Version) || 0) + 1;
    writeRow_(tbl, t);
    logTaskChanges_(ctx, before, t, changes);
    notifyTaskChanges_(ctx, before, t);
    bumpRev_();
    return { task: pub_(t), changes: changes.map(function (c) { return c.field; }) };
  });
}

function validateTask_(t, refs, before) {
  const errors = {};
  const set = function (f, m) { if (!errors[f]) errors[f] = m; };
  try { t.Title = str_(t.Title, 200, 'Title'); } catch (e) { set('Title', e.message); }
  if (!errors.Title && t.Title.length < 3) set('Title', 'Title must be at least 3 characters.');
  try { t.Description = str_(t.Description, 5000, 'Description', true); } catch (e) { set('Description', e.message); }
  t.Category = str_(t.Category, 100, 'Category');

  t.InitiativeID = str_(t.InitiativeID, 40, 'InitiativeID');
  if (t.InitiativeID && !refs.initiatives[t.InitiativeID]) set('InitiativeID', 'Unknown initiative.');
  t.ProjectID = str_(t.ProjectID, 40, 'ProjectID');
  if (t.ProjectID) {
    const pr = refs.projects[t.ProjectID];
    if (!pr) set('ProjectID', 'Unknown project.');
    else if (pr.InitiativeID) {
      if (!t.InitiativeID) t.InitiativeID = pr.InitiativeID;
      else if (t.InitiativeID !== pr.InitiativeID) set('ProjectID', 'This project belongs to a different initiative.');
    }
  }

  t.AssignedTo = lc_(t.AssignedTo);
  if (t.AssignedTo && (!refs.users[t.AssignedTo] || !refs.users[t.AssignedTo].Active)) set('AssignedTo', 'Assignee must be an active user (or leave blank for TBD).');
  t.Team = str_(t.Team, 60, 'Team');
  if (!t.Team && t.AssignedTo && refs.users[t.AssignedTo]) t.Team = refs.users[t.AssignedTo].Department || '';

  const collab = [];
  list_(t.Collaborators).map(lc_).forEach(function (e) {
    if (!e || e === t.AssignedTo || collab.indexOf(e) >= 0) return;
    if (!refs.users[e]) set('Collaborators', 'Unknown collaborator: ' + e);
    else collab.push(e);
  });
  t.Collaborators = collab.join(', ');

  if (PRIORITIES.indexOf(t.Priority) < 0) set('Priority', 'Choose a valid priority.');
  if (STATUSES.indexOf(t.Status) < 0) set('Status', 'Choose a valid status.');

  t.StartDate = str_(t.StartDate, 10, 'StartDate');
  t.DueDate = str_(t.DueDate, 10, 'DueDate');
  if (t.StartDate && !isYmd_(t.StartDate)) set('StartDate', 'Use the date format yyyy-mm-dd.');
  if (!t.DueDate) set('DueDate', 'Due date is required.');
  else if (!isYmd_(t.DueDate)) set('DueDate', 'Use the date format yyyy-mm-dd.');
  if (t.StartDate && t.DueDate && isYmd_(t.StartDate) && isYmd_(t.DueDate) && t.StartDate > t.DueDate) set('DueDate', 'Due date cannot be before the start date.');

  let prog = Number(t.Progress);
  if (t.Progress === '' || t.Progress == null) prog = 0;
  if (isNaN(prog) || prog < 0 || prog > 100) set('Progress', 'Progress must be between 0 and 100.');
  t.Progress = Math.round(Math.max(0, Math.min(100, prog || 0)));

  const deps = [];
  list_(t.DependsOn).map(function (d) { return d.toUpperCase(); }).forEach(function (d) {
    if (!d || deps.indexOf(d) >= 0) return;
    if (d === t.TaskID) set('DependsOn', 'A task cannot depend on itself.');
    else if (!refs.taskIdSet[d]) set('DependsOn', 'Unknown task: ' + d);
    else deps.push(d);
  });
  t.DependsOn = deps.join(', ');

  const links = String(t.Links || '').split(/\r?\n/).map(function (l) { return l.trim(); }).filter(String);
  if (links.length > 10) set('Links', 'Maximum 10 links.');
  links.forEach(function (l) {
    if (!/^https?:\/\/[^\s]+$/i.test(l) || l.length > 500) set('Links', 'Each link must be a full http(s) URL: ' + l.slice(0, 60));
  });
  t.Links = links.join('\n');

  if (Object.keys(errors).length) throw err_('VALIDATION', 'Please correct the highlighted fields.', { fields: errors });

  // Derived fields
  if (t.Status === 'Completed') {
    t.Progress = 100;
    if (!t.CompletedDate || before.Status !== 'Completed') t.CompletedDate = today_();
  } else {
    t.CompletedDate = '';
  }
}

function duplicateTask_(ctx, p) {
  const id = str_(p.id, 40, 'id');
  return withLock_(function () {
    requireRole_(ctx, ['Admin', 'Manager', 'Member'], 'Viewers cannot create tasks.');
    const tbl = readTable_('Tasks');
    const src = tbl.rows.find(function (r) { return r.TaskID === id; });
    if (!src) throw err_('NOT_FOUND', 'Task ' + id + ' was not found.');
    const refs = refs_(tbl.rows);
    const t = blank_('Tasks');
    TASK_FIELDS.forEach(function (f) { t[f] = src[f]; });
    t.Title = ('Copy of ' + src.Title).slice(0, 200);
    t.Status = 'Not Started'; t.Progress = 0; t.CompletedDate = '';
    if (refs.users[lc_(t.AssignedTo)] && !refs.users[lc_(t.AssignedTo)].Active) t.AssignedTo = ctx.email;
    if (!t.DueDate || t.DueDate < today_()) t.DueDate = addDays_(today_(), 7);
    if (t.StartDate && t.StartDate > t.DueDate) t.StartDate = '';
    t.TaskID = nextId_('TSK', refs.taskIds);
    validateTask_(t, refs, {});
    const now = nowIso_();
    t.CreatedBy = ctx.email; t.CreatedAt = now; t.UpdatedAt = now; t.UpdatedBy = ctx.email; t.Archived = false; t.Version = 1;
    appendRows_(tbl, [t]);
    logActivity_(ctx, 'Task', t.TaskID, 'Task created', 'Duplicated from ' + src.TaskID + '.');
    notifyTaskChanges_(ctx, null, t);
    bumpRev_();
    return { task: pub_(t), created: true };
  });
}

function archiveTask_(ctx, p) {
  const id = str_(p.id, 40, 'id');
  const archived = p.archived !== false;
  return withLock_(function () {
    const tbl = readTable_('Tasks');
    const t = tbl.rows.find(function (r) { return r.TaskID === id; });
    if (!t) throw err_('NOT_FOUND', 'Task ' + id + ' was not found.');
    if (!(isManager_(ctx) || lc_(t.CreatedBy) === ctx.email)) throw err_('FORBIDDEN', 'Only the task creator or a manager can archive this task.');
    checkVersion_(t, p.version, 'task');
    if (!!t.Archived === archived) return { task: pub_(t), unchanged: true };
    t.Archived = archived; t.UpdatedAt = nowIso_(); t.UpdatedBy = ctx.email; t.Version = (Number(t.Version) || 0) + 1;
    writeRow_(tbl, t);
    logActivity_(ctx, 'Task', id, archived ? 'Task archived' : 'Task restored', '"' + t.Title + '"');
    bumpRev_();
    return { task: pub_(t) };
  });
}

function logTaskChanges_(ctx, b, a, changes) {
  const fields = changes.map(function (c) { return c.field; });
  if (fields.indexOf('Status') >= 0) {
    logActivity_(ctx, 'Task', a.TaskID, a.Status === 'Completed' ? 'Task completed' : 'Status changed', b.Status + ' → ' + a.Status);
  }
  if (fields.indexOf('Priority') >= 0) logActivity_(ctx, 'Task', a.TaskID, 'Priority changed', b.Priority + ' → ' + a.Priority);
  if (fields.indexOf('AssignedTo') >= 0) logActivity_(ctx, 'Task', a.TaskID, 'Assignment changed', nameOf_(b.AssignedTo) + ' → ' + nameOf_(a.AssignedTo));
  const other = changes.filter(function (c) { return ['Status', 'Priority', 'AssignedTo', 'CompletedDate'].indexOf(c.field) < 0; });
  if (other.length) {
    logActivity_(ctx, 'Task', a.TaskID, 'Task updated', other.map(function (c) {
      if (['Description', 'Links'].indexOf(c.field) >= 0) return c.field + ' edited';
      return c.field + ': ' + (c.from === '' ? '—' : c.from) + ' → ' + (c.to === '' ? '—' : c.to);
    }).join('; ').slice(0, 900));
  }
}

function notifyTaskChanges_(ctx, b, a) {
  const label = a.TaskID + ' · ' + a.Title;
  const out = [];
  const stakeholders = [a.CreatedBy, a.AssignedTo].concat(list_(a.Collaborators));
  if ((!b || lc_(b.AssignedTo) !== lc_(a.AssignedTo)) && (a.AssignedTo || (b && b.AssignedTo))) {
    if (a.AssignedTo) out.push({ to: [a.AssignedTo], type: 'ASSIGNED', msg: ctx.name + ' assigned you ' + label });
    if (b && b.AssignedTo) out.push({ to: [b.AssignedTo], type: 'REASSIGNED', msg: label + ' was reassigned to ' + nameOf_(a.AssignedTo) });
  }
  const oldCollab = b ? list_(b.Collaborators).map(lc_) : [];
  const added = list_(a.Collaborators).map(lc_).filter(function (e) { return oldCollab.indexOf(e) < 0; });
  if (added.length) out.push({ to: added, type: 'ASSIGNED', msg: ctx.name + ' added you as a collaborator on ' + label });
  if (b && b.Status !== a.Status && a.Status === 'Blocked') out.push({ to: stakeholders, type: 'BLOCKED', msg: label + ' was marked Blocked by ' + ctx.name });
  if (b && b.Status !== a.Status && a.Status === 'Completed') out.push({ to: stakeholders, type: 'COMPLETED', msg: label + ' was completed by ' + ctx.name });
  const ev = Utilities.getUuid().slice(0, 8);
  out.forEach(function (n) { notify_(n.to, n.type, 'Task', a.TaskID, n.msg, ctx.email, n.type + ':' + a.TaskID + ':' + ev); });
}

/* =====================================================================
 *  COMMENTS (threaded)
 * ===================================================================== */

function addComment_(ctx, p) {
  const taskId = str_(p.taskId, 40, 'taskId');
  const parentId = str_(p.parentId, 40, 'parentId');
  let body;
  try { body = str_(p.body, 4000, 'Comment', true); } catch (e) { throw err_('VALIDATION', e.message); }
  if (!body) throw err_('VALIDATION', 'Comment cannot be empty.');
  return withLock_(function () {
    const task = readTable_('Tasks').rows.find(function (r) { return r.TaskID === taskId; });
    if (!task) throw err_('NOT_FOUND', 'Task ' + taskId + ' was not found.');
    const tbl = readTable_('Comments');
    let parent = null;
    if (parentId) {
      parent = tbl.rows.find(function (c) { return c.CommentID === parentId; });
      if (!parent || parent.TaskID !== taskId) throw err_('VALIDATION', 'The comment you are replying to does not belong to this task.');
      if (parent.Status === 'deleted') throw err_('VALIDATION', 'You cannot reply to a deleted comment.');
    }
    // Duplicate-submission guard: same author, same text, same task within 10 seconds.
    const dupe = tbl.rows.find(function (c) {
      return c.TaskID === taskId && lc_(c.AuthorEmail) === ctx.email && c.Body === body && c.ParentID === parentId &&
        (Date.now() - new Date(c.CreatedAt).getTime()) < 10000;
    });
    if (dupe) return { comment: pub_(dupe), comments: commentsFor_(taskId), duplicate: true };

    const c = blank_('Comments');
    c.CommentID = nextId_('CMT', tbl.rows.map(function (r) { return r.CommentID; }));
    c.TaskID = taskId; c.ParentID = parentId; c.Body = body;
    c.AuthorEmail = ctx.email; c.AuthorName = ctx.name; c.CreatedAt = nowIso_(); c.UpdatedAt = ''; c.Status = 'active';
    appendRows_(tbl, [c]);
    logActivity_(ctx, 'Task', taskId, parent ? 'Reply added' : 'Comment added', excerpt_(body, 140));

    const priorCommenters = tbl.rows.filter(function (r) { return r.TaskID === taskId; }).map(function (r) { return r.AuthorEmail; });
    const stakeholders = [task.CreatedBy, task.AssignedTo].concat(list_(task.Collaborators)).concat(priorCommenters);
    const label = taskId + ' · ' + task.Title;
    const mentioned = mentionsIn_(body);
    if (mentioned.length) notify_(mentioned, 'MENTION', 'Task', taskId, ctx.name + ' mentioned you on ' + label + ': "' + excerpt_(body, 90) + '"', ctx.email, 'MENTION:' + c.CommentID);
    const notMentioned = function (e) { return mentioned.indexOf(lc_(e)) < 0; };
    if (parent) {
      if (notMentioned(parent.AuthorEmail)) notify_([parent.AuthorEmail], 'REPLY', 'Task', taskId, ctx.name + ' replied to your comment on ' + label, ctx.email, 'REPLY:' + c.CommentID);
      notify_(stakeholders.filter(function (e) { return lc_(e) !== lc_(parent.AuthorEmail) && notMentioned(e); }), 'COMMENT', 'Task', taskId,
        ctx.name + ' replied in the discussion on ' + label, ctx.email, 'COMMENT:' + c.CommentID);
    } else {
      notify_(stakeholders.filter(notMentioned), 'COMMENT', 'Task', taskId, ctx.name + ' commented on ' + label, ctx.email, 'COMMENT:' + c.CommentID);
    }
    bumpRev_();
    return { comment: pub_(c), comments: commentsFor_(taskId) };
  });
}

function editComment_(ctx, p) {
  const id = str_(p.id, 40, 'id');
  let body;
  try { body = str_(p.body, 4000, 'Comment', true); } catch (e) { throw err_('VALIDATION', e.message); }
  if (!body) throw err_('VALIDATION', 'Comment cannot be empty.');
  return withLock_(function () {
    const tbl = readTable_('Comments');
    const c = tbl.rows.find(function (r) { return r.CommentID === id; });
    if (!c || c.Status === 'deleted') throw err_('NOT_FOUND', 'Comment not found.');
    if (lc_(c.AuthorEmail) !== ctx.email) throw err_('FORBIDDEN', 'You can only edit your own comments.');
    if (c.Body === body) return { comments: commentsFor_(c.TaskID) };
    const before = mentionsIn_(c.Body);
    c.Body = body; c.UpdatedAt = nowIso_(); c.Status = 'edited';
    writeRow_(tbl, c);
    const added = mentionsIn_(body).filter(function (e) { return before.indexOf(e) < 0; });
    if (added.length) notify_(added, 'MENTION', 'Task', c.TaskID, ctx.name + ' mentioned you on ' + c.TaskID + ': "' + excerpt_(body, 90) + '"', ctx.email, 'MENTION:' + c.CommentID);
    logActivity_(ctx, 'Comment', c.CommentID, 'Comment edited', 'On ' + c.TaskID + ': ' + excerpt_(body, 120));
    bumpRev_();
    return { comments: commentsFor_(c.TaskID) };
  });
}

function deleteComment_(ctx, p) {
  const id = str_(p.id, 40, 'id');
  return withLock_(function () {
    const tbl = readTable_('Comments');
    const c = tbl.rows.find(function (r) { return r.CommentID === id; });
    if (!c || c.Status === 'deleted') throw err_('NOT_FOUND', 'Comment not found.');
    if (lc_(c.AuthorEmail) !== ctx.email && ctx.role !== 'Admin') throw err_('FORBIDDEN', 'You can only delete your own comments.');
    c.Body = ''; c.UpdatedAt = nowIso_(); c.Status = 'deleted';
    writeRow_(tbl, c);
    logActivity_(ctx, 'Comment', c.CommentID, 'Comment deleted', 'On ' + c.TaskID + (lc_(c.AuthorEmail) !== ctx.email ? ' (moderated by admin)' : ''));
    bumpRev_();
    return { comments: commentsFor_(c.TaskID) };
  });
}

/** Emails of active users tagged as @Full Name (or @firstname / @email) in a comment. Longest names match first. */
function mentionsIn_(body) {
  const text = ' ' + String(body || '').toLowerCase();
  if (text.indexOf('@') < 0) return [];
  const found = [];
  const users = users_().filter(function (u) { return u.Active; })
    .sort(function (a, b) { return String(b.Name).length - String(a.Name).length; });
  let rest = text;
  users.forEach(function (u) {
    const keys = [lc_(u.Name), lc_(u.Email)].filter(String);
    keys.forEach(function (k) {
      let i = rest.indexOf('@' + k);
      while (i >= 0) {
        const after = rest.charAt(i + 1 + k.length);
        if (!/[a-z0-9]/.test(after)) {
          if (found.indexOf(lc_(u.Email)) < 0) found.push(lc_(u.Email));
          rest = rest.slice(0, i) + ' '.repeat(k.length + 1) + rest.slice(i + 1 + k.length);
        }
        i = rest.indexOf('@' + k, i + 1);
      }
    });
  });
  return found;
}

/* =====================================================================
 *  INITIATIVES & PROJECTS
 * ===================================================================== */

const INITIATIVE_FIELDS = ['Name', 'Description', 'Objective', 'Owner', 'Members', 'Priority', 'Stage', 'Category', 'Forum',
  'NeedleMover', 'WeeklyFocus', 'RedFlag', 'StartDate', 'TargetDate', 'Milestones', 'Risks'];

function saveInitiative_(ctx, p) {
  const patch = p.patch || {};
  const id = p.id ? str_(p.id, 40, 'id') : '';
  return withLock_(function () {
    const tbl = readTable_('Initiatives');
    const users = userMap_();
    const now = nowIso_();
    let rec, before = {};
    if (!id) {
      requireRole_(ctx, ['Admin', 'Manager'], 'Only managers and admins can create initiatives.');
      rec = blank_('Initiatives');
      rec.InitiativeID = nextId_('INI', tbl.rows.map(function (r) { return r.InitiativeID; }));
      rec.Stage = 'Under Design'; rec.Priority = 'Medium'; rec.NeedleMover = false; rec.WeeklyFocus = false;
    } else {
      rec = tbl.rows.find(function (r) { return r.InitiativeID === id; });
      if (!rec) throw err_('NOT_FOUND', 'Initiative ' + id + ' was not found.');
      if (!(isManager_(ctx) || lc_(rec.Owner) === ctx.email)) throw err_('FORBIDDEN', 'Only the owner or a manager can edit this initiative.');
      checkVersion_(rec, p.version, 'initiative');
      before = JSON.parse(JSON.stringify(rec));
    }
    INITIATIVE_FIELDS.forEach(function (f) { if (f in patch) rec[f] = patch[f]; });

    const errors = {};
    try { rec.Name = str_(rec.Name, 150, 'Name'); } catch (e) { errors.Name = e.message; }
    if (!errors.Name && rec.Name.length < 3) errors.Name = 'Name must be at least 3 characters.';
    ['Description', 'Objective', 'Milestones', 'Risks', 'RedFlag'].forEach(function (f) {
      try { rec[f] = str_(rec[f], 5000, f, true); } catch (e) { errors[f] = e.message; }
    });
    rec.Owner = lc_(rec.Owner);
    if (!rec.Owner || !users[rec.Owner]) errors.Owner = 'Owner must be an existing user.';
    rec.Members = list_(rec.Members).map(lc_).filter(function (e, i, a) { return e && users[e] && a.indexOf(e) === i; }).join(', ');
    if (PRIORITIES.indexOf(rec.Priority) < 0) errors.Priority = 'Choose a valid priority.';
    if (INITIATIVE_STAGES.indexOf(rec.Stage) < 0) errors.Stage = 'Choose a valid stage.';
    rec.Category = str_(rec.Category, 100, 'Category');
    rec.Forum = str_(rec.Forum, 100, 'Forum');
    rec.NeedleMover = truthy_(rec.NeedleMover);
    rec.WeeklyFocus = truthy_(rec.WeeklyFocus);
    rec.StartDate = str_(rec.StartDate, 10, 'StartDate'); rec.TargetDate = str_(rec.TargetDate, 10, 'TargetDate');
    if (rec.StartDate && !isYmd_(rec.StartDate)) errors.StartDate = 'Use yyyy-mm-dd.';
    if (rec.TargetDate && !isYmd_(rec.TargetDate)) errors.TargetDate = 'Use yyyy-mm-dd.';
    if (!errors.TargetDate && rec.StartDate && rec.TargetDate && rec.StartDate > rec.TargetDate) errors.TargetDate = 'Target date cannot be before the start date.';
    if (Object.keys(errors).length) throw err_('VALIDATION', 'Please correct the highlighted fields.', { fields: errors });

    // Stage cap (soft limit; client may confirm and retry with force:true)
    if (rec.Stage !== before.Stage && !p.force) {
      const cap = stageCaps_()[rec.Stage];
      if (cap) {
        const count = tbl.rows.filter(function (r) { return !r.Archived && r.Stage === rec.Stage && r.InitiativeID !== rec.InitiativeID; }).length;
        if (count >= cap) throw err_('STAGE_CAP', rec.Stage + ' already has ' + count + ' of ' + cap + ' initiatives. Move it anyway?', { stage: rec.Stage, count: count, cap: cap });
      }
    }

    if (!id) {
      rec.CreatedAt = now; rec.CreatedBy = ctx.email; rec.UpdatedAt = now; rec.UpdatedBy = ctx.email; rec.Archived = false; rec.Version = 1;
      appendRows_(tbl, [rec]);
      logActivity_(ctx, 'Initiative', rec.InitiativeID, 'Initiative created', '"' + rec.Name + '" owned by ' + nameOf_(rec.Owner) + ' (' + rec.Stage + ').');
    } else {
      const changes = diff_(before, rec, INITIATIVE_FIELDS);
      if (!changes.length) return { initiative: pub_(rec), unchanged: true };
      rec.UpdatedAt = now; rec.UpdatedBy = ctx.email; rec.Version = (Number(before.Version) || 0) + 1;
      writeRow_(tbl, rec);
      logActivity_(ctx, 'Initiative', rec.InitiativeID, changes.some(function (c) { return c.field === 'Stage'; }) ? 'Stage changed' : 'Initiative updated',
        changes.map(function (c) { return ['Description', 'Objective', 'Milestones', 'Risks'].indexOf(c.field) >= 0 ? c.field + ' edited' : c.field + ': ' + (c.from === '' ? '—' : c.from) + ' → ' + (c.to === '' ? '—' : c.to); }).join('; ').slice(0, 900));
    }
    bumpRev_();
    return { initiative: pub_(rec), created: !id };
  });
}

const PROJECT_FIELDS = ['Name', 'Description', 'InitiativeID', 'Owner', 'Status', 'StartDate', 'TargetDate'];

function saveProject_(ctx, p) {
  const patch = p.patch || {};
  const id = p.id ? str_(p.id, 40, 'id') : '';
  return withLock_(function () {
    const tbl = readTable_('Projects');
    const users = userMap_();
    const inits = {};
    readTable_('Initiatives').rows.forEach(function (r) { inits[r.InitiativeID] = r; });
    const now = nowIso_();
    let rec, before = {};
    if (!id) {
      requireRole_(ctx, ['Admin', 'Manager'], 'Only managers and admins can create projects.');
      rec = blank_('Projects');
      rec.ProjectID = nextId_('PRJ', tbl.rows.map(function (r) { return r.ProjectID; }));
      rec.Status = 'Planning';
    } else {
      rec = tbl.rows.find(function (r) { return r.ProjectID === id; });
      if (!rec) throw err_('NOT_FOUND', 'Project ' + id + ' was not found.');
      if (!(isManager_(ctx) || lc_(rec.Owner) === ctx.email)) throw err_('FORBIDDEN', 'Only the owner or a manager can edit this project.');
      checkVersion_(rec, p.version, 'project');
      before = JSON.parse(JSON.stringify(rec));
    }
    PROJECT_FIELDS.forEach(function (f) { if (f in patch) rec[f] = patch[f]; });
    const errors = {};
    try { rec.Name = str_(rec.Name, 150, 'Name'); } catch (e) { errors.Name = e.message; }
    if (!errors.Name && rec.Name.length < 3) errors.Name = 'Name must be at least 3 characters.';
    try { rec.Description = str_(rec.Description, 5000, 'Description', true); } catch (e) { errors.Description = e.message; }
    rec.InitiativeID = str_(rec.InitiativeID, 40, 'InitiativeID');
    if (rec.InitiativeID && !inits[rec.InitiativeID]) errors.InitiativeID = 'Unknown initiative.';
    rec.Owner = lc_(rec.Owner);
    if (!rec.Owner || !users[rec.Owner]) errors.Owner = 'Owner must be an existing user.';
    if (PROJECT_STATUSES.indexOf(rec.Status) < 0) errors.Status = 'Choose a valid status.';
    rec.StartDate = str_(rec.StartDate, 10, 'StartDate'); rec.TargetDate = str_(rec.TargetDate, 10, 'TargetDate');
    if (rec.StartDate && !isYmd_(rec.StartDate)) errors.StartDate = 'Use yyyy-mm-dd.';
    if (rec.TargetDate && !isYmd_(rec.TargetDate)) errors.TargetDate = 'Use yyyy-mm-dd.';
    if (Object.keys(errors).length) throw err_('VALIDATION', 'Please correct the highlighted fields.', { fields: errors });

    if (!id) {
      rec.CreatedAt = now; rec.CreatedBy = ctx.email; rec.UpdatedAt = now; rec.UpdatedBy = ctx.email; rec.Archived = false; rec.Version = 1;
      appendRows_(tbl, [rec]);
      logActivity_(ctx, 'Project', rec.ProjectID, 'Project created', '"' + rec.Name + '" owned by ' + nameOf_(rec.Owner) + '.');
    } else {
      const changes = diff_(before, rec, PROJECT_FIELDS);
      if (!changes.length) return { project: pub_(rec), unchanged: true };
      rec.UpdatedAt = now; rec.UpdatedBy = ctx.email; rec.Version = (Number(before.Version) || 0) + 1;
      writeRow_(tbl, rec);
      logActivity_(ctx, 'Project', rec.ProjectID, 'Project updated', changes.map(function (c) { return c.field === 'Description' ? 'Description edited' : c.field + ': ' + (c.from || '—') + ' → ' + (c.to || '—'); }).join('; ').slice(0, 900));
    }
    bumpRev_();
    return { project: pub_(rec), created: !id };
  });
}

function archiveSimple_(ctx, p, sheetName, label) {
  const id = str_(p.id, 40, 'id');
  const archived = p.archived !== false;
  return withLock_(function () {
    const tbl = readTable_(sheetName);
    const key = SCHEMA[sheetName].key;
    const rec = tbl.rows.find(function (r) { return r[key] === id; });
    if (!rec) throw err_('NOT_FOUND', label + ' ' + id + ' was not found.');
    if (!(isManager_(ctx) || lc_(rec.Owner) === ctx.email)) throw err_('FORBIDDEN', 'Only the owner or a manager can archive this ' + label.toLowerCase() + '.');
    checkVersion_(rec, p.version, label.toLowerCase());
    rec.Archived = archived; rec.UpdatedAt = nowIso_(); rec.UpdatedBy = ctx.email; rec.Version = (Number(rec.Version) || 0) + 1;
    writeRow_(tbl, rec);
    logActivity_(ctx, label, id, label + (archived ? ' archived' : ' restored'), '"' + rec.Name + '"');
    bumpRev_();
    const out = {}; out[label.toLowerCase()] = pub_(rec);
    return out;
  });
}

/* =====================================================================
 *  NOTIFICATIONS
 * ===================================================================== */

function notify_(recipients, type, entityType, entityId, message, actorEmail, dedupeKey) {
  const users = userMap_();
  const seen = {};
  const rows = [];
  (recipients || []).map(lc_).forEach(function (r) {
    if (!r || seen[r] || r === lc_(actorEmail) || !users[r] || !users[r].Active) return;
    seen[r] = true;
    rows.push({ Recipient: r, Type: type, EntityType: entityType, EntityID: entityId, Message: String(message).slice(0, 300),
      Actor: actorEmail || '', CreatedAt: nowIso_(), Read: false, DedupeKey: dedupeKey + ':' + r });
  });
  if (!rows.length) return 0;
  const tbl = readTable_('Notifications');
  const existing = {};
  tbl.rows.forEach(function (n) { existing[n.DedupeKey] = true; });
  const fresh = rows.filter(function (n) { return !existing[n.DedupeKey]; });
  const ids = tbl.rows.map(function (n) { return n.NotificationID; });
  fresh.forEach(function (n) { n.NotificationID = nextId_('NTF', ids); ids.push(n.NotificationID); });
  if (fresh.length) appendRows_(tbl, fresh);
  return fresh.length;
}

function markNotifications_(ctx, p) {
  const ids = Array.isArray(p.ids) ? p.ids.map(String) : [];
  const all = p.all === true;
  return withLock_(function () {
    const tbl = readTable_('Notifications');
    let n = 0;
    tbl.rows.forEach(function (r) {
      if (lc_(r.Recipient) !== ctx.email || r.Read) return;
      if (all || ids.indexOf(r.NotificationID) >= 0) { r.Read = true; writeRow_(tbl, r); n++; }
    });
    return { marked: n };
  });
}

/** Time-driven (daily) — installed by setupHealthcareBoard(). Creates DUE_SOON and OVERDUE notifications once per task/due date. */
function runDeadlineScan() {
  REQ = {};
  return withLock_(function () {
    const s = settings_();
    const today = today_();
    const soonDays = Math.max(0, Number(s.DUE_SOON_DAYS) || 2);
    const horizon = addDays_(today, soonDays);
    let created = 0;
    readTable_('Tasks').rows.forEach(function (t) {
      if (t.Archived || t.Status === 'Completed' || t.Status === 'Cancelled' || !isYmd_(t.DueDate)) return;
      const to = [t.AssignedTo].concat(list_(t.Collaborators));
      const label = t.TaskID + ' · ' + t.Title;
      if (t.DueDate < today) {
        created += notify_(to.concat([t.CreatedBy]), 'OVERDUE', 'Task', t.TaskID, label + ' is overdue (was due ' + t.DueDate + ').', '', 'OVERDUE:' + t.TaskID + ':' + t.DueDate);
      } else if (t.DueDate <= horizon) {
        created += notify_(to, 'DUE_SOON', 'Task', t.TaskID, label + (t.DueDate === today ? ' is due today.' : ' is due on ' + t.DueDate + '.'), '', 'DUE_SOON:' + t.TaskID + ':' + t.DueDate);
      }
    });
    if (created) bumpRev_();
    console.log('Deadline scan created ' + created + ' notifications.');
    return created;
  });
}

