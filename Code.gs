/**
 * Creates / upgrades every tab, header, format, setting, the first admin,
 * ID counters and the daily deadline trigger. Never deletes data.
 * Run from the Apps Script editor: select setupHealthcareBoard ▸ Run.
 */
function setupHealthcareBoard() {
  REQ = {};
  const ss = ss_();
  const report = ['Healthcare Initiatives Board setup — ' + new Date().toISOString(), 'Spreadsheet: ' + ss.getName()];
  withLock_(function () {
    Object.keys(SCHEMA).forEach(function (name) { report.push(ensureSheet_(ss, name, SCHEMA[name])); });
    REQ = {};
    report.push(ensureSettings_());
    REQ = {};
    report.push(seedTeam_());
    REQ = {};
    report.push(ensureAdmin_());
    report.push(syncSequences_());
    ensureGuide_(ss);
    report.push('• _Guide tab refreshed (documentation of every sheet and column).');
    report.push(ensureTrigger_());
    bumpRev_();
  });
  const other = ss.getSheets().map(function (s) { return s.getName(); })
    .filter(function (n) { return !SCHEMA[n] && n !== '_Guide'; });
  if (other.length) report.push('• Other tabs left untouched: ' + other.join(', '));
  const msg = report.join('\n');
  console.log(msg);
  try { SpreadsheetApp.getUi().alert('Setup complete', msg, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) { /* run from editor */ }
  return msg;
}

function ensureSheet_(ss, name, def) {
  let sh = ss.getSheetByName(name);
  const created = !sh;
  if (!sh) sh = ss.insertSheet(name);
  const lastCol = sh.getLastColumn();
  const existing = lastCol ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); }) : [];
  const wanted = def.cols.map(function (c) { return c[0]; });

  if (!created && sh.getLastRow() > 1 && existing.indexOf(def.key) < 0) {
    throw err_('SETUP_CONFLICT', 'A tab named "' + name + '" already contains data without a "' + def.key +
      '" column. Rename that tab (e.g. "' + name + ' (old)") and run setup again — nothing was changed.');
  }
  const missing = wanted.filter(function (h) { return existing.indexOf(h) < 0; });
  const headers = existing.filter(String).length ? existing.slice() : [];
  if (!headers.length) {
    headers.push.apply(headers, wanted);
  } else {
    missing.forEach(function (h) { headers.push(h); });
  }
  if (sh.getMaxColumns() < headers.length) sh.insertColumnsAfter(sh.getMaxColumns(), headers.length - sh.getMaxColumns());
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);

  // Formatting
  const header = sh.getRange(1, 1, 1, headers.length);
  header.setFontWeight('bold').setBackground('#0B2545').setFontColor('#FFFFFF').setVerticalAlignment('middle');
  sh.setFrozenRows(1);
  sh.setRowHeight(1, 30);
  try { sh.setTabColor(def.color); } catch (e) { /* ignore */ }
  const rowsBelow = Math.max(1, sh.getMaxRows() - 1);
  def.cols.forEach(function (c) {
    const col = headers.indexOf(c[0]) + 1;
    sh.getRange(1, col).setNote(c[2] + '  [type: ' + c[1] + ']');
    if (c[1] === 'text' || c[1] === 'date' || c[1] === 'ts') sh.getRange(2, col, rowsBelow, 1).setNumberFormat('@');
    if (c[1] === 'num') sh.getRange(2, col, rowsBelow, 1).setNumberFormat('0');
    const width = /Description|Body|Message|Details|Objective|Milestones|Risks|Links|Title|Name/.test(c[0]) ? 260 : (c[1] === 'ts' ? 170 : 130);
    sh.setColumnWidth(col, width);
  });
  if (!sh.getFilter()) sh.getRange(1, 1, sh.getMaxRows(), headers.length).createFilter();

  const dataRows = Math.max(0, sh.getLastRow() - 1);
  return '• ' + name + ': ' + (created ? 'created' : 'found (' + dataRows + ' existing rows preserved)') +
    (missing.length && !created ? ', added columns: ' + missing.join(', ') : '') + '.';
}

function ensureSettings_() {
  const tbl = readTable_('Settings');
  const have = {};
  tbl.rows.forEach(function (r) { have[r.Key] = r; });
  const add = DEFAULT_SETTINGS.filter(function (d) { return !have[d[0]]; })
    .map(function (d) { return { Key: d[0], Value: d[1], Description: d[2] }; });
  if (add.length) appendRows_(tbl, add);
  // Keep descriptions current without touching values.
  DEFAULT_SETTINGS.forEach(function (d) {
    const r = have[d[0]];
    if (r && r.Description !== d[2]) { r.Description = d[2]; writeRow_(tbl, r); }
  });
  return '• Settings: ' + (add.length ? 'added ' + add.map(function (a) { return a.Key; }).join(', ') : 'all keys present (values untouched)') + '.';
}

function ensureAdmin_() {
  const tbl = readTable_('Users');
  const hasAdmin = tbl.rows.some(function (r) { return r.Role === 'Admin' && r.Active; });
  if (hasAdmin) return '• Users: ' + tbl.rows.length + ' user(s), administrator present.';
  let email = '';
  try { email = lc_(Session.getEffectiveUser().getEmail()); } catch (e) { /* ignore */ }
  if (!email) return '• Users: WARNING — no administrator. Add a row in Users with Role = Admin and Active = TRUE.';
  const existing = tbl.rows.find(function (r) { return lc_(r.Email) === email; });
  if (existing) { existing.Role = 'Admin'; existing.Active = true; writeRow_(tbl, existing); }
  else appendRows_(tbl, [{ Email: email, Name: email.split('@')[0], Role: 'Admin', Department: '', Title: 'Administrator', Active: true, CreatedAt: nowIso_(), LastLogin: '' }]);
  return '• Users: ' + email + ' set as the first administrator.';
}

function syncSequences_() {
  const props = PropertiesService.getScriptProperties();
  const out = [];
  Object.keys(SCHEMA).forEach(function (name) {
    const def = SCHEMA[name];
    if (!def.prefix) return;
    let max = 0;
    readTable_(name).rows.forEach(function (r) {
      const m = String(r[def.key] || '').match(/-(\d+)$/);
      if (m) max = Math.max(max, Number(m[1]));
    });
    const cur = Number(props.getProperty('SEQ_' + def.prefix) || 0);
    if (max > cur) props.setProperty('SEQ_' + def.prefix, String(max));
    out.push(def.prefix + '=' + Math.max(max, cur));
  });
  return '• ID counters: ' + out.join(', ') + '.';
}

function ensureGuide_(ss) {
  let sh = ss.getSheetByName('_Guide');
  if (!sh) sh = ss.insertSheet('_Guide');
  sh.clear();
  const rows = [['Sheet', 'Column', 'Type', 'Description']];
  rows.push(['(system)', '', '', 'This tab is regenerated by setupHealthcareBoard(). Edits here are overwritten. Do not store data here.']);
  Object.keys(SCHEMA).forEach(function (name) {
    rows.push([name, '', 'SHEET', SCHEMA[name].purpose]);
    SCHEMA[name].cols.forEach(function (c) { rows.push([name, c[0], c[1], c[2]]); });
  });
  sh.getRange(1, 1, rows.length, 4).setValues(rows);
  sh.getRange(1, 1, 1, 4).setFontWeight('bold').setBackground('#0B2545').setFontColor('#FFFFFF');
  sh.setFrozenRows(1);
  sh.setColumnWidth(1, 130); sh.setColumnWidth(2, 150); sh.setColumnWidth(3, 70); sh.setColumnWidth(4, 640);
  try { sh.setTabColor('#999999'); } catch (e) { /* ignore */ }
}

function ensureTrigger_() {
  try {
    const exists = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'runDeadlineScan'; });
    if (exists) return '• Daily deadline trigger already installed.';
    ScriptApp.newTrigger('runDeadlineScan').timeBased().everyDays(1).atHour(7).create();
    return '• Daily deadline trigger installed (runs around 07:00).';
  } catch (e) {
    return '• Could not install the daily trigger automatically (' + e.message + '). Add a time-driven trigger for runDeadlineScan manually.';
  }
}

/** Optional: makes a full copy of the spreadsheet in your Drive. Run before any manual restructuring. */
function backupSpreadsheet() {
  const ss = ss_();
  const name = ss.getName() + ' — backup ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HHmm');
  const copy = ss.copy(name);
  console.log('Backup created: ' + name + ' (' + copy.getId() + ')');
  return copy.getId();
}

/* ---------- BULK IMPORT ---------- */

const IMPORT_STATUS = {
  'not started': 'Not Started', 'todo': 'Not Started', 'to do': 'Not Started', 'open': 'Not Started', 'new': 'Not Started', 'planned': 'Not Started',
  'under design': 'Not Started', 'design': 'Not Started', 'backlog': 'Not Started',
  'in progress': 'In Progress', 'doing': 'In Progress', 'wip': 'In Progress', 'ongoing': 'In Progress', 'build': 'In Progress', 'building': 'In Progress', 'live': 'In Progress', 'active': 'In Progress',
  'blocked': 'Blocked', 'stuck': 'Blocked', 'on hold': 'Blocked', 'parked': 'Blocked', 'red flag': 'Blocked',
  'under review': 'Under Review', 'review': 'Under Review', 'in review': 'Under Review', 'waiting': 'Under Review', 'awaiting feedback': 'Under Review',
  'completed': 'Completed', 'complete': 'Completed', 'done': 'Completed', 'closed': 'Completed', 'finished': 'Completed',
  'cancelled': 'Cancelled', 'canceled': 'Cancelled', 'dropped': 'Cancelled'
};

/**
 * Bulk-creates tasks. Each row: {Title, Owner (name or email; blank/TBD = unassigned), Team, Status, Priority,
 * DueDate, StartDate, Initiative (name or ID), Category, Description, Progress, Links}.
 * dryRun:true validates and returns the mapping without writing anything.
 */
function importTasks_(ctx, p) {
  requireRole_(ctx, ['Admin', 'Manager'], 'Only managers and admins can import tasks.');
  const rows = Array.isArray(p.rows) ? p.rows.slice(0, 500) : [];
  if (!rows.length) throw err_('VALIDATION', 'Nothing to import.');
  const run = function () {
    const tbl = readTable_('Tasks');
    const refs = refs_(tbl.rows);
    const users = users_();
    const byName = {};
    users.forEach(function (u) { if (u.Active) { byName[lc_(u.Name)] = u.Email; byName[lc_(u.Email)] = u.Email; byName[lc_(u.Email).split('@')[0]] = u.Email; } });
    const iniByName = {};
    Object.keys(refs.initiatives).forEach(function (id) { iniByName[lc_(refs.initiatives[id].Name)] = id; iniByName[lc_(id)] = id; });
    const existingTitles = {};
    tbl.rows.forEach(function (t) { if (!t.Archived) existingTitles[lc_(t.Title) + '|' + lc_(t.AssignedTo)] = t.TaskID; });
    const teams = list_(settings_().DEPARTMENTS);
    const newInis = {};
    const out = [];
    const now = nowIso_();
    rows.forEach(function (r, i) {
      const res = { row: i + 1, ok: true, warnings: [] };
      const ownerRaw = String(r.Owner || r.AssignedTo || '').trim();
      let owner = '';
      if (ownerRaw && !/^(tbd|unassigned|-|—|n\/a|none)$/i.test(ownerRaw)) {
        owner = byName[lc_(ownerRaw)] || '';
        if (!owner) res.warnings.push('Owner "' + ownerRaw + '" not found — imported as TBD');
      }
      let status = STATUSES.indexOf(String(r.Status || '').trim()) >= 0 ? String(r.Status).trim() : IMPORT_STATUS[lc_(r.Status)] || '';
      if (!status) { if (r.Status) res.warnings.push('Status "' + r.Status + '" → Not Started'); status = 'Not Started'; }
      let prio = PRIORITIES.filter(function (x) { return lc_(x) === lc_(r.Priority); })[0];
      if (!prio) { if (/^p?0$|urgent/i.test(r.Priority)) prio = 'Critical'; else if (/^p?1$/i.test(r.Priority)) prio = 'High'; else if (/^p?3$/i.test(r.Priority)) prio = 'Low'; else prio = 'Medium'; }
      const due = normDate_(r.DueDate);
      const start = normDate_(r.StartDate);
      let iniId = '';
      const iniRaw = String(r.Initiative || '').trim();
      if (iniRaw) {
        iniId = iniByName[lc_(iniRaw)] || newInis[lc_(iniRaw)] || '';
        if (!iniId && p.createInitiatives !== false) { iniId = 'NEW:' + iniRaw; newInis[lc_(iniRaw)] = iniId; res.warnings.push('Initiative "' + iniRaw + '" will be created'); }
      }
      let team = String(r.Team || '').trim();
      const teamMatch = teams.filter(function (x) { return lc_(x) === lc_(team); })[0];
      team = teamMatch || team;
      const t = blank_('Tasks');
      t.Title = String(r.Title || '').trim();
      t.Description = String(r.Description || '').trim();
      t.Category = String(r.Category || '').trim();
      t.Team = team;
      t.AssignedTo = owner;
      t.Status = status; t.Priority = prio;
      t.StartDate = start || '';
      t.DueDate = due || addDays_(today_(), 14);
      if (!due) res.warnings.push('No due date → ' + t.DueDate);
      t.Progress = r.Progress === '' || r.Progress === undefined ? (status === 'Completed' ? 100 : 0) : Number(String(r.Progress).replace('%', ''));
      t.Links = String(r.Links || '').trim();
      t.InitiativeID = '';
      if (t.StartDate && t.StartDate > t.DueDate) { t.StartDate = ''; res.warnings.push('Start date after due date — start date dropped'); }
      try {
        validateTask_(t, refs, {});
      } catch (e) {
        res.ok = false;
        res.error = e.details && e.details.fields ? Object.keys(e.details.fields).map(function (k) { return k + ': ' + e.details.fields[k]; }).join('; ') : e.message;
      }
      if (existingTitles[lc_(t.Title) + '|' + lc_(t.AssignedTo)]) { res.ok = false; res.error = 'Already exists as ' + existingTitles[lc_(t.Title) + '|' + lc_(t.AssignedTo)] + ' (skipped)'; res.duplicate = true; }
      existingTitles[lc_(t.Title) + '|' + lc_(t.AssignedTo)] = 'row ' + (i + 1);
      res.task = { Title: t.Title, AssignedTo: t.AssignedTo, Team: t.Team, Status: t.Status, Priority: t.Priority, DueDate: t.DueDate, Initiative: iniRaw };
      res._t = t; res._ini = iniId;
      out.push(res);
    });
    const good = out.filter(function (x) { return x.ok; });
    if (!p.dryRun && good.length) {
      // Create missing initiatives first
      const iniTbl = readTable_('Initiatives');
      const created = {};
      Object.keys(newInis).forEach(function (k) {
        if (!good.some(function (x) { return x._ini === newInis[k]; })) return;
        const firstRow = good.filter(function (x) { return x._ini === newInis[k]; })[0];
        const rec = blank_('Initiatives');
        rec.InitiativeID = nextId_('INI', iniTbl.rows.map(function (x) { return x.InitiativeID; }));
        rec.Name = newInis[k].slice(4).slice(0, 150); rec.Owner = firstRow._t.AssignedTo || ctx.email; rec.Priority = 'Medium'; rec.Stage = 'Build';
        rec.CreatedAt = now; rec.CreatedBy = ctx.email; rec.UpdatedAt = now; rec.UpdatedBy = ctx.email; rec.Archived = false; rec.Version = 1;
        rec.NeedleMover = false; rec.WeeklyFocus = false;
        appendRows_(iniTbl, [rec]);
        created[newInis[k]] = rec.InitiativeID;
        logActivity_(ctx, 'Initiative', rec.InitiativeID, 'Initiative created', '"' + rec.Name + '" (bulk import)');
      });
      const ids = tbl.rows.map(function (x) { return x.TaskID; });
      const toAdd = good.map(function (x) {
        const t = x._t;
        t.InitiativeID = x._ini ? (created[x._ini] || x._ini) : '';
        t.TaskID = nextId_('TSK', ids); ids.push(t.TaskID);
        t.CreatedBy = ctx.email; t.CreatedAt = now; t.UpdatedAt = now; t.UpdatedBy = ctx.email; t.Archived = false; t.Version = 1;
        x.task.TaskID = t.TaskID;
        return t;
      });
      appendRows_(tbl, toAdd);
      logActivity_(ctx, 'Task', toAdd[0].TaskID + '…' + toAdd[toAdd.length - 1].TaskID, 'Tasks imported', toAdd.length + ' tasks imported by ' + ctx.name + '.');
      const per = {};
      toAdd.forEach(function (t) { if (t.AssignedTo && t.AssignedTo !== ctx.email) (per[t.AssignedTo] = per[t.AssignedTo] || []).push(t.TaskID); });
      Object.keys(per).forEach(function (e) {
        notify_([e], 'ASSIGNED', 'Task', per[e][0], ctx.name + ' assigned you ' + per[e].length + ' imported task' + (per[e].length > 1 ? 's' : '') + ' (' + per[e].slice(0, 3).join(', ') + (per[e].length > 3 ? '…' : '') + ')', ctx.email, 'IMPORT:' + per[e][0]);
      });
      bumpRev_();
    }
    return {
      dryRun: !!p.dryRun, total: out.length, importable: good.length, imported: p.dryRun ? 0 : good.length,
      results: out.map(function (x) { return { row: x.row, ok: x.ok, error: x.error || '', warnings: x.warnings, task: x.task }; })
    };
  };
  return p.dryRun ? run() : withLock_(run);
}

/** Accepts yyyy-mm-dd, dd/mm/yyyy, dd-mm-yyyy, "27 Oct 2026", "Oct 27, 2026", Date objects. Returns yyyy-mm-dd or ''. */
function normDate_(v) {
  if (!v) return '';
  if (v instanceof Date && !isNaN(v)) return Utilities.formatDate(v, tz_(), 'yyyy-MM-dd');
  const s = String(v).trim();
  let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (m) return m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
  m = s.match(/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{2,4})$/);
  if (m) { const y = m[3].length === 2 ? '20' + m[3] : m[3]; return y + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[1]).slice(-2); }
  const d = new Date(s + (/\d{4}/.test(s) ? '' : ' ' + today_().slice(0, 4)));
  if (!isNaN(d)) return Utilities.formatDate(d, tz_(), 'yyyy-MM-dd');
  return '';
}

